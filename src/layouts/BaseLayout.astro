---
import "../styles/global.css";
import SiteHeader from "../components/chrome/SiteHeader.astro";
import SiteFooter from "../components/chrome/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  // Homepage opts in: header floats over the immersive hero, no top spacer.
  heroHeader?: boolean;
  /**
   * Page-specific JSON-LD, appended after the site-wide Organization node.
   * Only add schema that describes content actually visible on the page.
   */
  jsonLd?: Record<string, unknown>[];
  /**
   * Keep this page out of the index. Only the 404 uses it: the HTTP status is
   * the real signal, this is belt-and-braces for anything that renders the
   * page without seeing the status.
   */
  noindex?: boolean;
}

const {
  title,
  description = "An Australian technology partner. Ongoing technology management, specialist projects and practical advice — one place to call, and technology that stays yours.",
  heroHeader = false,
  jsonLd = [],
  noindex = false,
} = Astro.props;

// Canonical URL. `site` is configured centrally in astro.config.mjs, so every
// page derives its origin from one place. Trailing slashes are normalised away
// (except the root) so a page can only ever have one canonical form.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL("/og-image.jpg", Astro.site).href;

// Site-wide entity. Deliberately minimal: every field below is verifiable from
// the site itself or the repository. No address, phone, opening hours, ratings,
// reviews or physical premises — none of that is established, and inventing it
// for schema would be fabricating business facts.
//
// Note on ProfessionalService: it is a LocalBusiness subtype whose expected
// properties are address, geo and openingHours. Using it here would invite
// exactly the fabrication above, so Organization carries the same true facts
// without the implication of a storefront.
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "TWNY",
  legalName: "TWNY Pty Ltd",
  url: new URL("/", Astro.site).href,
  email: "hello@twny.com.au",
  description:
    "An Australian technology partner. Ongoing technology management, specialist projects and practical advice.",
  areaServed: { "@type": "Country", name: "Australia" },
};
---

<!doctype html>
<html lang="en-AU" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* Icons. PNG rather than SVG: the mark is the wordmark set in Space
        Grotesk, and a browser's SVG-favicon sandbox will not reliably load a
        webfont, so it is rasterised once at build-time-independent sizes. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TWNY" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A lighthouse on a dark coastal headland, its beam sweeping across the bay."
    />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* The public site is dark-only for this phase (`.dark` is set statically on
        <html>). This only arms reveal animations before paint, avoiding a flash
        of un-hidden content. */}
    <script is:inline>
      (function () {
        try {
          if (
            "IntersectionObserver" in window &&
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            document.documentElement.classList.add("anim-ready");
          }
        } catch (e) {}
      })();
    </script>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organization)}
    />
    {
      jsonLd.map((node) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col font-body">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-paper focus:text-ink focus:px-3 focus:py-2 focus:border focus:border-line"
      >Skip to content</a
    >
    <SiteHeader overHero={heroHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

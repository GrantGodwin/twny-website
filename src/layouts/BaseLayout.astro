---
import "../styles/global.css";
import SiteHeader from "../components/chrome/SiteHeader.astro";
import SiteFooter from "../components/chrome/SiteFooter.astro";
import { orgId } from "../data/site";
// The two faces on the critical path of every page — body text and the
// display face used by the wordmark and headings. Preloaded so the swap from
// the fallback font happens before first paint rather than a frame after it;
// measured, that removes most of the small layout shift the pages had at
// font-swap time. The remaining weights load normally.
import interRegular from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import groteskSemibold from "@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  // Homepage opts in: header floats over the immersive hero, no top spacer.
  heroHeader?: boolean;
  /**
   * Page-specific JSON-LD nodes, merged into the page's single @graph after
   * the site-wide Organization (and, on the homepage, WebSite) nodes. Refer to
   * the organisation with `{ "@id": orgId(Astro.site) }` rather than restating it. Only
   * add schema that describes content actually visible on the page.
   */
  jsonLd?: Record<string, unknown>[];
  /**
   * Keep this page out of the index. Only the 404 uses it: the HTTP status is
   * the real signal, this is belt-and-braces for anything that renders the
   * page without seeing the status.
   */
  noindex?: boolean;
}

const {
  title,
  description = "An Australian technology partner. Ongoing technology management, specialist projects and practical advice — one place to call, and technology that stays yours.",
  heroHeader = false,
  jsonLd = [],
  noindex = false,
} = Astro.props;

// Canonical URL. `site` is configured centrally in astro.config.mjs, so every
// page derives its origin from one place. Trailing slashes are normalised away
// (except the root) so a page can only ever have one canonical form.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL("/og-image.jpg", Astro.site).href;
const siteUrl = new URL("/", Astro.site).href;

// One entity model for the whole site, emitted as a single @graph per page.
//
// Organization carries a stable @id so every other node — the homepage
// WebSite, the two Service nodes on /services — can point at the same entity
// instead of restating an anonymous copy of it. Deliberately minimal: every
// field is verifiable from the site or the repository. No address, phone,
// opening hours, ratings, reviews, sameAs or physical premises — none of that
// is established (the LinkedIn page still carries superseded positioning and
// is not linked until it is updated), and inventing any of it for schema would
// be fabricating business facts.
//
// Note on ProfessionalService: it is a LocalBusiness subtype whose expected
// properties are address, geo and openingHours. Using it here would invite
// exactly the fabrication above, so Organization carries the same true facts
// without the implication of a storefront.
const ORG_ID = orgId(Astro.site);
const WEBSITE_ID = `${siteUrl}#website`;

const organization = {
  "@type": "Organization",
  "@id": ORG_ID,
  name: "TWNY",
  legalName: "TWNY Pty Ltd",
  url: siteUrl,
  email: "hello@twny.com.au",
  logo: new URL("/logo.png", Astro.site).href,
  description:
    "Managed Technology and Professional Services for small and mid-sized Australian businesses: Microsoft 365, devices, security, backup, websites and specialist projects.",
  areaServed: { "@type": "Country", name: "Australia" },
};

// The WebSite node belongs to the homepage only — one site, declared once.
const website = {
  "@type": "WebSite",
  "@id": WEBSITE_ID,
  name: "TWNY",
  url: siteUrl,
  inLanguage: "en-AU",
  publisher: { "@id": ORG_ID },
};

const graph = {
  "@context": "https://schema.org",
  "@graph": [organization, ...(path === "/" ? [website] : []), ...jsonLd],
};
---

<!doctype html>
<html lang="en-AU" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="font" type="font/woff2" href={interRegular} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={groteskSemibold} crossorigin />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* Icons. PNG rather than SVG: the mark is the wordmark set in Space
        Grotesk, and a browser's SVG-favicon sandbox will not reliably load a
        webfont, so it is rasterised once at build-time-independent sizes. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TWNY" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="TWNY — Technology, simplified. The twny wordmark over a lighthouse on a dark coastal headland."
    />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* The public site is dark-only for this phase (`.dark` is set statically on
        <html>). This only arms reveal animations before paint, avoiding a flash
        of un-hidden content. */}
    <script is:inline>
      (function () {
        try {
          if (
            "IntersectionObserver" in window &&
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            document.documentElement.classList.add("anim-ready");
          }
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
  </head>
  <body class="min-h-screen flex flex-col font-body">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-paper focus:text-ink focus:px-3 focus:py-2 focus:border focus:border-line"
      >Skip to content</a
    >
    <SiteHeader overHero={heroHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

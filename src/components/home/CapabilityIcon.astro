---
// Icons for the homepage "What we help with" columns.
//
// One family only: Phosphor Regular, vendored as four local SVGs under
// src/assets/icons/phosphor (see the README there for provenance and licence).
// Astro compiles an imported .svg into an inline SVG component, so these ship
// as markup in the page — no icon font, no runtime library, no extra requests.
//
// Every glyph is the same 256x256 viewBox at the same Phosphor weight, so the
// four share an optical size and stroke weight without per-icon tuning. Colour
// comes from the caller (Mineral) via currentColor. No boxes, no glow, no
// gradient, no animation.
import Browser from "../../assets/icons/phosphor/browser.svg";
import Devices from "../../assets/icons/phosphor/devices.svg";
import ShieldCheck from "../../assets/icons/phosphor/shield-check.svg";
import TreeStructure from "../../assets/icons/phosphor/tree-structure.svg";

interface Props {
  name: "devices" | "shield-check" | "browser" | "tree-structure";
  class?: string;
}

const icons = {
  devices: Devices,
  "shield-check": ShieldCheck,
  browser: Browser,
  "tree-structure": TreeStructure,
} as const;

const { name, class: className = "h-10 w-10" } = Astro.props;
const Glyph = icons[name];
---

{/* Decorative: the heading beside it already names the area, so the icon is
    hidden from assistive technology rather than duplicating that label. */}
<Glyph class={className} fill="currentColor" aria-hidden="true" role="presentation" />

---
import Wordmark from "./Wordmark.astro";
import { email, mailto } from "../../data/site";

// Footer as a brand bookend, not an administrative panel.
//
// Deliberately short. It carries the wordmark, the two real pages, the one
// contact address and the copyright — nothing else. In particular it does NOT
// carry support hours or response times: those belong in a service agreement,
// proposal or support arrangement, where they can be stated accurately for a
// specific client, not on a public marketing page where they read as a promise
// to everyone. No social links, no newsletter, no legal links to pages that
// don't exist, no second CTA, no service list.
const nav = [
  { label: "Services", href: "/services" },
  { label: "Contact", href: "/contact" },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-paper">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 py-14">
    <div class="grid gap-10 sm:grid-cols-[1.4fr_1fr] sm:items-start sm:gap-12">
      {/* brand bookend */}
      <div class="max-w-sm">
        <Wordmark class="text-2xl" />
        <p class="mt-4 font-display text-lg font-medium leading-snug text-ink">
          Technology, simplified.
        </p>
        <p class="mt-2 text-sm leading-relaxed text-steel text-pretty">
          Managed Technology and Professional Services for Australian
          businesses.
        </p>
      </div>

      {/* the two real pages, and the one way to reach us */}
      <div class="sm:text-right">
        <nav aria-label="Footer" class="flex flex-col gap-2.5 sm:items-end">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="text-sm text-steel transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={mailto}
            class="text-sm text-mineral transition-colors hover:text-mineral-strong"
          >
            {email}
          </a>
        </nav>
        <p class="mt-8 font-mono text-xs text-steel">© {year} TWNY Pty Ltd</p>
      </div>
    </div>
  </div>
</footer>

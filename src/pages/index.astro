---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import CapabilityIcon from "../components/home/CapabilityIcon.astro";
import Button from "../components/ui/Button.astro";
import {
  capabilities,
  capabilitiesLede,
  engagements,
  engagementsLede,
  philosophy,
  rotatingTerms,
  workGroups,
  workLede,
} from "../data/offer";

// Homepage narrative order (locked):
//   promise -> areas of help -> engagement model -> differentiation ->
//   evidence -> action.
// "What we help with" sits directly beneath the hero because the hero's scroll
// cue points at it; "How we work" follows, so a visitor understands the two
// engagement types before the proof section splits along them.
//
// Surfaces still step tonally between neighbours: hero (photo over Ink) ->
// paper -> sand -> band -> sand -> band -> footer (paper).
---

<BaseLayout
  title="TWNY — Managed Technology and Professional Services"
  description="Managed Technology and Professional Services for Australian businesses — Microsoft 365, devices, security, backup, websites and specialist projects."
  heroHeader={true}
>
  {/* HERO */}
  <Hero />

  {/* WHAT WE HELP WITH — four plain-English areas of help, not four services.
      Each aggregates work that appears on the Services page under Managed
      Technology, Professional Services, or both.

      Set as editorial columns, not a feature row: everything left-aligned,
      each column opened by the same hairline rule, icon as a marginal mark
      rather than a centred badge. Four columns only where there is genuinely
      room for them (the `wide` breakpoint, 1200px, where the container is
      fully open); a two-by-two below that, so the copy
      never has to shrink to fit; a single column on phones. The rule-per-item
      construction is what makes that reflow free — no per-breakpoint divider
      arithmetic. bg-paper: a lifted step out of the hero's Ink. */}
  <section id="what-we-help-with" class="bg-paper text-ink">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 lg:py-28">
      <div data-animate class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-mineral">
          What we help with
        </p>
        <h2 class="mt-6 font-display text-3xl font-semibold leading-[1.07] text-balance sm:text-4xl">
          Technology shouldn't be another job.
        </h2>
        <p class="mt-5 max-w-xl text-[0.9688rem] leading-[1.6] text-steel text-pretty">
          {capabilitiesLede}
        </p>
      </div>

      <div
        data-animate
        class="capability-grid mt-14 grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2 lg:mt-16 wide:grid-cols-4"
      >
        {
          capabilities.map((c) => (
            <div class="capability-item">
              <CapabilityIcon name={c.icon} class="h-9 w-9 text-mineral" />
              <h3 class="mt-5 font-display text-xl font-semibold leading-snug text-ink text-balance">
                {c.heading}
              </h3>
              <p class="mt-3 max-w-[24rem] text-[0.9688rem] leading-[1.6] text-steel text-pretty">
                {c.body}
              </p>
            </div>
          ))
        }
      </div>

      <div data-animate class="mt-16 lg:mt-20">
        <Button href="/services" variant="mineral">
          See our services
        </Button>
      </div>
    </div>
  </section>

  {/* HOW WE WORK — the two engagement types, and only ever two. Prose only,
      two columns, one hairline: the grid above already carries the "what", so
      this must not become a second feature list. bg-sand steps back down to
      the base canvas, distinct from paper above and band below. */}
  <section id="how-we-work" class="bg-sand text-ink">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 lg:py-28">
      <div data-animate class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-mineral">
          How we work
        </p>
        <h2 class="mt-6 font-display text-3xl font-semibold leading-[1.07] text-balance sm:text-4xl">
          Two ways to work with us.
        </h2>
        <p class="mt-5 max-w-xl text-[0.9688rem] leading-[1.6] text-steel text-pretty">
          {engagementsLede}
        </p>
      </div>

      <div
        data-animate
        class="engagement-pair mt-14 grid gap-x-16 gap-y-12 sm:grid-cols-2 lg:mt-16"
      >
        {
          engagements.map((e) => (
            <div class="engagement-item">
              <p class="font-mono text-xs uppercase tracking-[0.18em] text-steel">
                {e.label}
              </p>
              <h3 class="mt-4 font-display text-xl font-semibold leading-snug text-ink lg:text-2xl">
                {e.name}
              </h3>
              <p class="mt-4 max-w-[30rem] text-[0.9688rem] leading-[1.6] text-steel text-pretty">
                {e.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* WHY TWNY — the homepage's emotional centre. Demonstrates the philosophy
      (we carry the complexity so clients don't have to) rather than asserting
      differentiation as a principles list. No cards, no icons, no diagram —
      typography and one restrained vertical-reel motion carry the section. The
      rotating clause is not the feature; it's a specimen of the complexity
      being carried, so its meaning survives entirely intact with motion off or
      JS disabled (the markup's initial clause is simply what's shown). */}
  <section id="why-twny" class="bg-band text-ink">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 lg:py-20">
      <div data-animate class="max-w-[63rem]">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-mineral">
          Why TWNY
        </p>
        <h2 class="mt-5 font-display text-balance">
          <span class="block text-3xl font-semibold leading-[1.05] text-ink sm:text-4xl lg:text-5xl">
            Simple for you.
          </span>
          <span class="headline-secondary mt-[0.35rem] block text-[1.24rem] font-medium leading-snug sm:text-[1.375rem] lg:text-[1.65rem]">
            Never simple behind the scenes.
          </span>
        </h2>

        <p
          data-animate
          data-rotating-term-wrapper
          class="mt-4 font-display text-base leading-snug text-ink sm:text-lg lg:mt-5 lg:text-xl"
        >
          <span aria-hidden="true">
            <span class="block sm:inline">You shouldn't need to understand</span>
            <span class="term-reel">
              <span class="term-reel__track" data-rotating-track>
                <span
                  class="term-reel__item term-reel__item--edge font-bold italic text-ember"
                  data-reel-prev
                >
                  {rotatingTerms[rotatingTerms.length - 1]}
                </span>
                <span class="term-reel__item font-bold italic text-ember" data-reel-current>
                  {rotatingTerms[0]}
                </span>
                <span
                  class="term-reel__item term-reel__item--edge font-bold italic text-ember"
                  data-reel-next
                >
                  {rotatingTerms[1]}
                </span>
              </span>
            </span>
          </span>
          <span class="sr-only">
            You shouldn't need to understand {rotatingTerms.join(", ")}
          </span>
        </p>

        <p
          data-animate
          class="mt-4 max-w-[548px] text-sm leading-relaxed text-steel text-pretty sm:mt-5 sm:text-base"
        >
          Technology is complicated. The jargon, the platforms and the
          security requirements keep changing — we stay across all of it,
          so the detail never lands on your desk.
        </p>
      </div>

      <div
        data-animate
        class="divider-fade relative mt-10 max-w-[54rem] pt-8 grid gap-x-8 gap-y-6 sm:grid-cols-3 lg:mt-12"
      >
        {
          philosophy.map((point) => (
            <div>
              <h3 class="font-display text-base font-semibold text-ink">
                {point.title}
              </h3>
              <p class="mt-2 text-[0.9688rem] leading-[1.6] text-steel text-pretty">
                {point.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* BOTH HALVES, IN PRACTICE — the proof, split along the two engagement
      types rather than presented as an undifferentiated grid. Managed
      Technology carries one substantial example; Professional Services carries
      three shorter ones. The counts are deliberately unequal — that is what
      the work is, and forcing parity would mean inventing an example.

      So the asymmetry is composed rather than apologised for: the single
      Managed Technology engagement is set as a feature panel on the left — a
      lifted surface with a hairline, its pills anchored to the foot — and it
      stretches to the height of the three-entry Professional Services list
      beside it. One large thing next to three small things, not one small
      thing above a lot of empty column.

      Factual rules, unchanged: no quotation marks, no attributed praise, no
      logos (client or vendor), no metrics, no storage quantities, no savings,
      no claimed outcomes. Nothing here implies a client has reviewed or
      approved the wording — see docs/client-work-approval.md. Flat bg-sand:
      the dip between the two bg-band editorial sections either side. */}
  <section id="selected-work" class="bg-sand text-ink">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 lg:py-28">
      <div data-animate class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-steel">
          Selected work
        </p>
        <h2 class="mt-6 font-display text-3xl font-semibold leading-[1.07] text-balance sm:text-4xl">
          Both halves, in practice.
        </h2>
        <p class="mt-5 max-w-xl text-[0.9688rem] leading-[1.6] text-steel text-pretty">
          {workLede}
        </p>
      </div>

      <div
        data-animate
        class="work-split mt-14 grid gap-x-12 gap-y-14 lg:mt-16 lg:grid-cols-[0.94fr_1.06fr] lg:gap-x-14"
      >
        {
          workGroups.map((group) => {
            const feature = group.items.length === 1;
            return (
              <section class="work-region flex flex-col" aria-label={group.engagement}>
                <p class="font-mono text-xs uppercase tracking-[0.18em] text-steel">
                  {group.label}
                </p>
                <h3 class="mt-3 font-display text-xl font-semibold leading-snug text-mineral">
                  {group.engagement}
                </h3>

                {feature ? (
                  /* One engagement, set large: a feature panel that fills the
                     region's height so the two halves sit level. */
                  <div class="work-feature mt-7 flex flex-1 flex-col rounded-sm border border-line bg-paper p-7 sm:p-9 lg:p-10">
                    {group.items.map((item) => (
                      <div class="flex flex-1 flex-col">
                        <p class="font-display text-2xl font-semibold leading-snug text-ink text-balance lg:text-[1.75rem]">
                          {item.client}
                        </p>
                        <p class="mt-4 max-w-[30rem] text-[1.0625rem] leading-[1.6] text-steel text-pretty">
                          {item.summary}
                        </p>
                        <ul class="mt-8 flex flex-wrap gap-2 lg:mt-auto lg:pt-10">
                          {item.pills.map((pill) => (
                            <li class="service-pill">{pill}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                ) : (
                  /* Three engagements, set as a hairline-separated list. */
                  <ul class="work-list mt-7 flex flex-col">
                    {group.items.map((item) => (
                      <li class="work-item">
                        <p class="font-display text-lg font-semibold leading-snug text-ink text-balance lg:text-xl">
                          {item.client}
                        </p>
                        <p class="mt-3 max-w-[32rem] text-[0.9688rem] leading-[1.6] text-steel text-pretty">
                          {item.summary}
                        </p>
                        <ul class="mt-4 flex flex-wrap gap-2">
                          {item.pills.map((pill) => (
                            <li class="service-pill">{pill}</li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* CLOSING SECTION — "the handshake". The homepage's final beat, whose
      single job is to remove the last hesitation before getting in touch.
      Deliberately does not restate the hero proposition. Flat bg-band, and
      the most generously padded section on the page: the exhale is made with
      space, not colour. Left-aligned, single column; no cards, icons,
      diagrams or steps. */}
  <section id="getting-started" class="bg-band text-ink">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-28 sm:py-36 lg:py-48">
      <div data-animate class="max-w-2xl">
        <h2 class="font-display text-3xl font-semibold leading-[1.05] text-balance sm:text-4xl lg:text-5xl">
          You don't need to have all the answers.
        </h2>

        <div class="mt-8 max-w-xl space-y-5 text-base leading-relaxed text-steel text-pretty sm:text-[1.0625rem]">
          <p>That's where we come in.</p>
          <p>
            Start with the problem rather than the service. Tell us what's
            happening, and we'll work out what matters and where it makes
            sense to begin.
          </p>
        </div>

        <div class="mt-20">
          <Button href="/contact" variant="ember">Get in touch</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Two-up editorial grid ("How we work"). The same hairline language as the
     capability columns — a quiet fade-edge rule between items, never a boxed
     card. Vertical between columns, horizontal between stacked rows. */
  .engagement-pair {
    align-items: start;
  }
  .engagement-item {
    position: relative;
  }
  @media (min-width: 640px) {
    .engagement-pair > .engagement-item:nth-child(2n)::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: -2rem;
      width: 1px;
      background: linear-gradient(
        to bottom,
        transparent,
        color-mix(in srgb, var(--line) 60%, transparent) 18%,
        color-mix(in srgb, var(--line) 60%, transparent) 82%,
        transparent
      );
    }
  }
  @media (max-width: 639px) {
    .engagement-item + .engagement-item::before {
      content: "";
      position: absolute;
      top: -1.5rem;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        to right,
        transparent,
        color-mix(in srgb, var(--line) 48%, transparent) 30%,
        color-mix(in srgb, var(--line) 48%, transparent) 70%,
        transparent
      );
    }
  }

  /* "Both halves, in practice." — two engagement regions side by side on
     desktop, stacked on everything narrower. The regions stretch to a shared
     height (grid default), which is what lets the feature panel on the left
     fill the same vertical space as the three-entry list on the right. A
     fade-edge hairline separates the stacked groups on narrow screens. */
  .work-region {
    position: relative;
  }
  @media (max-width: 1023px) {
    .work-region + .work-region::before {
      content: "";
      position: absolute;
      top: -1.75rem;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        to right,
        transparent,
        color-mix(in srgb, var(--line) 48%, transparent) 30%,
        color-mix(in srgb, var(--line) 48%, transparent) 70%,
        transparent
      );
    }
  }
  /* The Professional Services list: a hairline above every entry after the
     first, same language as the capability columns. */
  .work-list > .work-item + .work-item {
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
  }

  /* Service pills — visibly pill-shaped, quiet, and identical everywhere they
     appear. Outline only: a filled chip would compete with the Ember action,
     and a Mineral fill would read as a link. No icons: four to nine of these
     sit together, and glyphs at this size turn a calm row into noise. */
  .service-pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--line) 90%, transparent);
    border-radius: 9999px;
    padding: 0.3125rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel);
    white-space: nowrap;
  }

  /* "What we help with" — every column opens on the same hairline rule, so
     the set reads as one editorial row (or two, or four) at any column count
     without boxed cards and without per-breakpoint divider arithmetic. */
  .capability-item {
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
  }

  /* "Why TWNY" philosophy row divider — the same fade-edged hairline used
     between the capability columns, widened and lightened slightly for this
     wider, lower-contrast context. */
  .divider-fade::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--line) 80%, transparent) 30%,
      color-mix(in srgb, var(--line) 80%, transparent) 70%,
      transparent
    );
  }

  /* "Why TWNY" headline — second line reads as a quieter continuation of
     the first, not a caption: a touch warmer than pure Steel, without
     reaching the full contrast of the dominant line. */
  .headline-secondary {
    color: color-mix(in srgb, var(--steel) 58%, var(--ink) 42%);
  }

  /* "Why TWNY" rotating clause. The clause is now a phrase rather than a
     single term, so at narrow widths the lead-in sits on its own line and the
     reel takes the line beneath it (the `block sm:inline` on the lead-in) —
     that keeps every rotation on ONE line at 360px instead of rewrapping the
     sentence as clauses of different lengths pass through.

     The clipping window is exactly one line tall, so only the active clause is
     ever visible at rest — no permanently-visible neighbours above or below.
     The previous/next clauses only become momentarily visible, in full Ember,
     while one slides out and the next slides in; nothing fades or dims, the
     track itself transitions. A fixed minimum width holds the longest clause,
     so the line never reflows as clauses of different lengths rotate. */
  .term-reel {
    position: relative;
    display: inline-block;
    height: 1.35em;
    min-width: 100%;
    max-width: 100%;
    overflow: hidden;
    vertical-align: -0.35em;
  }
  .term-reel__track {
    display: block;
    transform: translateY(-33.3333%);
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .term-reel__item {
    display: block;
    height: 1.35em;
    line-height: 1.35em;
    white-space: nowrap;
    text-align: left;
  }
  @media (min-width: 640px) {
    .term-reel {
      margin-left: 0.28em;
      min-width: 21rem;
      max-width: none;
    }
  }
  @media (min-width: 1024px) {
    .term-reel {
      min-width: 24rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .term-reel {
      height: auto;
      min-width: 0;
      overflow: visible;
      vertical-align: baseline;
    }
    .term-reel__track {
      transform: none !important;
      transition: none;
    }
    .term-reel__item--edge {
      display: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const targets = document.querySelectorAll<HTMLElement>("[data-animate]");
  if (!reduce && "IntersectionObserver" in window && targets.length) {
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in");
            obs.unobserve(entry.target);
          }
        }
      },
      // Pre-trigger: the root is extended 12% of the viewport BELOW the fold,
      // so a section starts revealing just before it scrolls into view and is
      // already settled by the time it is actually being read.
      { threshold: 0, rootMargin: "0px 0px 12% 0px" }
    );
    targets.forEach((el) => io.observe(el));
  }
</script>

<script define:vars={{ terms: rotatingTerms }}>
  // "Why TWNY" rotating clause — a vertical reel (translateY on a 3-item
  // track), not a crossfade, carousel or typing effect. The clauses are longer
  // than the single terms they replaced, so the dwell is longer too: a reader
  // has to be able to finish one before the next arrives.
  // Pauses on hover/focus and when scrolled out of view. Under
  // prefers-reduced-motion the CSS above hides the edge slivers and strips the
  // transform/transition entirely, so this script does nothing and the
  // markup's initial static clause is simply what shows.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const track = document.querySelector("[data-rotating-track]");
  const prevEl = document.querySelector("[data-reel-prev]");
  const currentEl = document.querySelector("[data-reel-current]");
  const nextEl = document.querySelector("[data-reel-next]");
  const wrapper = document.querySelector("[data-rotating-term-wrapper]");

  if (track && prevEl && currentEl && nextEl && !reduceMotion && terms.length > 1) {
    let index = 0;
    let hoverPaused = false;
    let outOfView = false;

    const render = () => {
      prevEl.textContent = terms[(index - 1 + terms.length) % terms.length];
      currentEl.textContent = terms[index];
      nextEl.textContent = terms[(index + 1) % terms.length];
    };
    render();

    const advance = () => {
      if (hoverPaused || outOfView) return;
      track.style.transform = "translateY(0%)";
      track.addEventListener(
        "transitionend",
        () => {
          index = (index - 1 + terms.length) % terms.length;
          track.style.transition = "none";
          track.style.transform = "translateY(-33.3333%)";
          render();
          track.getBoundingClientRect();
          requestAnimationFrame(() => {
            track.style.transition = "";
          });
        },
        { once: true }
      );
    };

    setInterval(advance, 2600);

    wrapper?.addEventListener("mouseenter", () => (hoverPaused = true));
    wrapper?.addEventListener("mouseleave", () => (hoverPaused = false));
    wrapper?.addEventListener("focusin", () => (hoverPaused = true));
    wrapper?.addEventListener("focusout", () => (hoverPaused = false));

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) outOfView = !entry.isIntersecting;
        },
        { threshold: 0.2 }
      );
      const section = document.getElementById("why-twny");
      if (section) io.observe(section);
    }
  }
</script>

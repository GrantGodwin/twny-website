---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import FAQ from "../components/blocks/FAQ.astro";
import {
  engagementRows,
  managed,
  professional,
  howWeWork,
  serviceFaqs,
} from "../data/services";
import { mailto } from "../data/site";

// The homepage's second chapter, restructured around the two ways TWNY works:
// Managed Technology (ongoing responsibility) and Professional Services
// (defined project and advisory work). Same design system as the homepage:
// tonal surface steps as the only section transition, the fade-edge hairline as
// the only within-section divider, matched eyebrow/heading typography, and the
// three-role palette — Ink for statements, Mineral for labels and links, Ember
// for the single action.
//
// NO PRICING on this page or anywhere on the public site. Core / Business /
// Strategic are described as increasing levels of responsibility, never as
// price cards and never as a comparison matrix.

// Structured data describing what this page actually shows: the two service
// shapes, and the FAQ that is genuinely rendered below. Every question and
// answer below is read from the same `serviceFaqs` source the page renders, so
// the markup cannot drift from the visible content. No prices — Offer/price is
// deliberately absent, in line with the no-public-pricing rule.
const provider = { "@type": "Organization", name: "TWNY" };
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Managed Technology",
    serviceType: "Managed technology services",
    description:
      "Ongoing management of the technology a business relies on: Microsoft 365, devices, identity and access, security, backup, networks, suppliers, and websites and domains where relevant.",
    provider,
    areaServed: { "@type": "Country", name: "Australia" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Professional Services",
    serviceType: "Technology consulting and project services",
    description:
      "Defined project, advisory and specialist work: technology advice, research and analysis, Microsoft 365 and workplace projects, automation, digital presence, and remediation and transition.",
    provider,
    areaServed: { "@type": "Country", name: "Australia" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: serviceFaqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Services — Managed Technology and Professional Services | TWNY"
  description="Two ways to work with us: ongoing management of the technology your business relies on, and defined project, advisory and specialist work when there's a harder problem to solve."
  jsonLd={jsonLd}
>
  {/* HERO — the statement and the single action on the left; the two
      engagement shapes on the right as two calm rows, so the page's whole
      structure is legible before a word of detail. */}
  <section class="bg-sand text-ink">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 sm:py-24 lg:py-28">
      <div class="grid gap-14 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-20">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-mineral mb-5">
            Services
          </p>
          <h1 class="font-display text-4xl font-semibold leading-[1.05] text-balance sm:text-5xl lg:text-[3.5rem]">
            One technology partner, two ways to work.
          </h1>
          <p class="mt-6 max-w-md text-lg leading-relaxed text-steel text-pretty">
            We provide ongoing management for the technology your business
            relies on, and defined specialist work when there is a project,
            decision or harder problem to solve.
          </p>
          <div class="mt-9">
            <Button href={mailto} variant="ember">Get in touch</Button>
          </div>
        </div>

        <div class="engagement-rows">
          {
            engagementRows.map((e) => (
              <div class="engagement-row py-7 first:pt-0 last:pb-0">
                <p class="font-mono text-xs uppercase tracking-[0.18em] text-steel">
                  {e.label}
                </p>
                <p class="mt-3 font-display text-xl font-medium text-mineral">
                  {e.name}
                </p>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-ink/70 text-pretty">
                  {e.line}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* MANAGED TECHNOLOGY — the ongoing relationship. The customer-level story
      first, then what the arrangement covers, then the levels of responsibility.
      No pricing, no comparison matrix, no self-configuration. */}
  <section id="managed-technology" class="bg-paper text-ink">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-mineral">
          {managed.eyebrow}
        </p>
        <h2 class="mt-6 font-display text-3xl font-semibold leading-[1.07] text-balance sm:text-4xl">
          {managed.heading}
        </h2>
        <div class="mt-6 space-y-5 text-base leading-relaxed text-steel text-pretty sm:text-lg">
          {managed.body.map((para) => <p>{para}</p>)}
        </div>
      </div>

      {/* what Managed Technology covers — label + one line, in customer language */}
      <div class="divider-rule mt-16 pt-12 lg:mt-20 lg:pt-14">
        <h3 class="font-display text-xl font-medium text-ink">
          {managed.areasHeading}
        </h3>
        <div class="mt-10 grid gap-x-12 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
          {
            managed.areas.map((a) => (
              <div>
                <p class="font-mono text-xs uppercase tracking-[0.18em] text-mineral">
                  {a.label}
                </p>
                <p class="mt-3 text-[0.9375rem] leading-relaxed text-steel text-pretty">
                  {a.line}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      {/* levels of responsibility — described, never priced or compared */}
      <div class="divider-rule mt-16 pt-12 lg:mt-20 lg:pt-14">
        <div class="max-w-2xl">
          <h3 class="font-display text-xl font-medium text-ink text-balance">
            {managed.levelsHeading}
          </h3>
          <p class="mt-4 text-base leading-relaxed text-steel text-pretty">
            {managed.levelsLede}
          </p>
        </div>

        <div class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-3">
          {
            managed.levels.map((level) => (
              <div>
                <p class="font-display text-lg font-semibold text-ink">
                  {level.name}
                </p>
                <p class="mt-3 text-[0.9375rem] leading-relaxed text-steel text-pretty">
                  {level.body}
                </p>
              </div>
            ))
          }
        </div>

        <p class="mt-14 max-w-2xl text-base leading-relaxed text-ink text-pretty">
          {managed.ownership}
        </p>
      </div>
    </div>
  </section>

  {/* PROFESSIONAL SERVICES — defined work, grouped into a small number of
      understandable customer problems rather than an internal catalogue. */}
  <section id="professional-services" class="bg-band text-ink">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-mineral">
          {professional.eyebrow}
        </p>
        <h2 class="mt-6 font-display text-3xl font-semibold leading-[1.07] text-balance sm:text-4xl">
          {professional.heading}
        </h2>
        <div class="mt-6 space-y-5 text-base leading-relaxed text-steel text-pretty sm:text-lg">
          {professional.body.map((para) => <p>{para}</p>)}
        </div>
      </div>

      <div class="mt-14 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
        {
          professional.groups.map((g) => (
            <div>
              <h3 class="font-display text-lg font-medium text-ink text-balance">
                {g.title}
              </h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-steel text-pretty">
                {g.body}
              </p>
            </div>
          ))
        }
      </div>

      <p class="mt-16 max-w-2xl text-base font-medium leading-relaxed text-ink text-pretty sm:text-lg lg:mt-20">
        {professional.bridge}
      </p>
    </div>
  </section>

  {/* WORKING TOGETHER IS SIMPLE — three plain columns, no arrows, no process
      diagram; one reassurance line beneath. */}
  <section class="bg-sand text-ink">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 lg:py-28">
      <h2 class="font-display text-2xl font-semibold leading-[1.1] text-balance sm:text-3xl">
        {howWeWork.heading}
      </h2>

      <div class="mt-14 grid gap-x-12 gap-y-10 sm:grid-cols-3 lg:mt-16">
        {
          howWeWork.steps.map((s) => (
            <div>
              <h3 class="font-display text-lg font-medium text-ink text-balance">{s.title}</h3>
              <p class="mt-3 text-base leading-relaxed text-steel text-pretty">{s.body}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-14 max-w-2xl text-lg font-medium leading-relaxed text-ink text-pretty lg:mt-16">
        {howWeWork.footnote}
      </p>
    </div>
  </section>

  {/* FAQ + CLOSING — the FAQ, then the page's strongest beat: the close. */}
  <section class="bg-band text-ink">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 lg:py-28">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-steel mb-8">FAQ</p>
      <FAQ items={serviceFaqs} />

      <div class="mt-24 max-w-2xl">
        <h2 class="font-display text-3xl font-semibold leading-[1.05] text-balance sm:text-4xl lg:text-5xl">
          Not sure where it fits? Start with the problem.
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-steel text-pretty">
          Tell us what's happening and we'll tell you plainly whether we're the
          right fit — and if we're not, we'll say so.
        </p>
        <div class="mt-10">
          <Button href={mailto} variant="ember">Get in touch</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The homepage's fade-edge hairline is the only within-section divider —
     between the two engagement rows in the hero, and between the three
     movements of the Managed Technology section. */
  .engagement-row + .engagement-row,
  .divider-rule {
    position: relative;
  }
  .engagement-row + .engagement-row::before,
  .divider-rule::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--line) 80%, transparent) 30%,
      color-mix(in srgb, var(--line) 80%, transparent) 70%,
      transparent
    );
  }
</style>
